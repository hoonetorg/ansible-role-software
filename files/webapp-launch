#!/bin/sh
# managed by ansible-role-software (web apps)
# webapp-launch <browser command> <id> <url>: the site as an app window in its own browser data dir per user and app
# (own cookies/logins, not in the browser's profile list); the profile inside is named after the id, so every web app
# gets its own window class
[ $# -eq 3 ] || { echo "usage: webapp-launch <browser command> <id> <url>" >&2; exit 2; }
exec "$1" --user-data-dir="${XDG_DATA_HOME:-$HOME/.local/share}/webapps/$2" --profile-directory="$2" --app="$3"
